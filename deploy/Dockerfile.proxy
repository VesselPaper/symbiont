# 共生之缚 入口网关镜像
#
# 不是单纯的静态托管：这个 nginx 同时负责 TLS 终止、限流、静态托管与后端反代。
#
# 游戏 Web 版由 scripts/export_web.ps1 导出到 client/build/web（不进镜像，
# 缺省时只提供 /index.html 落地页与 /status.html 网关状态页，代理与负载均衡照常可用）。
# 要挂真实游戏包，在 compose 里解开这条挂载：
#   - ../client/build/web:/usr/share/nginx/html/game:ro
FROM nginx:alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/html/ /usr/share/nginx/html/

RUN mkdir -p /usr/share/nginx/html/game
