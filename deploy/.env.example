# 部署环境变量示例（可以提交，里面没有真密码）
#
# 真实值由 scripts/gen_env.ps1 生成到 deploy/.env，.env 不进仓库。

# 镜像 tag：scripts/build_images.ps1 会写成 git 短 sha
IMAGE_TAG=local

# ---- 数据库 ----
MYSQL_DATABASE=symbiont
MYSQL_USER=symbiont
# 下面两项必须换成真实随机值，示例值只能用于看一眼字段名
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# ---- 网关 ----
SYMBIONT_API_HOST=server
SYMBIONT_API_PORT=8000
SYMBIONT_TLS_CERT=/etc/nginx/certs/server.crt
SYMBIONT_TLS_KEY=/etc/nginx/certs/server.key

# 限流：每秒放行速率、突发容量、单 IP 并发上限
SYMBIONT_RATE_LIMIT=8r/s
SYMBIONT_RATE_BURST=20
SYMBIONT_RATE_CONN=20

# 请求体上限：远程存档没这么大，超过就是有人在灌包
SYMBIONT_MAX_BODY_SIZE=4m
