; Godot 4.5 工程配置 —— 共生之缚 Symbiont
; M1-01：输入映射（键盘 physical_keycode）+ 测试竞技场作为主场景（正式主菜单在 M1-06）。

config_version=5

[application]

config/name="Symbiont 共生之缚"
config/description="类恶魔城 2D 游戏：自下而上探索深渊地牢，在献祭与人性之间抉择。"
run/main_scene="res://scenes/world/test_arena.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

