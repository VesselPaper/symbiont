# ---------- Godot 4 ----------
# .godot/ 是缓存与导入元数据目录，不提交（Godot 4 官方推荐）
.godot/

# ---------- Python / 服务器 ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---------- 构建 / 导出产物 ----------
# 游戏 Web/桌面导出产物（由 scripts/export_*.ps1 生成）
client/build/
client/export/
deploy/web/
# 生成的数据库（由 tools/build_game_data.py 生成）
database/game_data/game_data.db

# ---------- 日志 / 临时 ----------
*.log
*.tmp

# ---------- 系统 / 编辑器 ----------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
